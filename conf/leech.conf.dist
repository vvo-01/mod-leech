[worldserver]

########################################
# Leech Config
########################################
#
#    Leech.Enable
#        Description: Enable the module
#        Default:     0 - Disabled
#                     1 - Enabled
#

Leech.Enable = 1

#
#    Leech.DungeonsOnly
#        Description: Enable leeching only in dungeons and raids
#        Default:     1 - Enabled
#                     0 - Disabled (works everywhere)
#

Leech.DungeonsOnly = 0

#
#    Leech.Amount
#        Description: Fraction of damage dealt that is applied as a heal.
#                     0 = none, 0.5 = 50%, 1 = 100%, 2 = 200%
#        Default:     0.05 - 5%
#

Leech.Amount = 0.05

#
#    Leech.AllowSelfDamage
#        Description: Allow leech from self-inflicted damage (reflect, fall damage, etc.)
#        Default:     0 - Disabled
#                     1 - Enabled
#

Leech.AllowSelfDamage = 0

#
#    Leech.RequiredItemId
#        Description: Item ID required in bags to activate leech.
#        Default:     0 - No item required
#                     xxxxx - Specific item ID
#

Leech.RequiredItemId = 0

#
#    Leech.PetDamage
#        Description: Where pet damage leech goes.
#                     pet   - heal the pet
#                     owner - heal the owner
#                     none  - disable leech from pet damage
#        Default:     pet
#

Leech.PetDamage = pet
